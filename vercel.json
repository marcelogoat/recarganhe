{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "*.gif",
      "use": "@vercel/static"
    },
    {
      "src": "lovable.dev/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/create-pix", "dest": "/api/create-pix.js" },
    { "src": "/api/check-status(.*)", "dest": "/api/check-status.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
